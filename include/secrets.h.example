#pragma once

// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored so your credentials never get committed.

// WPA2 password for the logger's own "ZEVA CAN" access point (dashboard / OTA
// updates). 8-63 characters.
#define SECRET_AP_PASSWORD "your-ap-password"

// Home WiFi network the logger looks for while idle, to auto-sync logs
#define SECRET_HOME_SSID "your-home-ssid"
#define SECRET_HOME_PASSWORD "your-home-password"

// Google Apps Script Web App deployment path (everything after the host)
// used to upload the latest CSV log when the home network is found.
#define SECRET_UPLOAD_SCRIPT_PATH "/macros/s/YOUR_DEPLOYMENT_ID/exec"
